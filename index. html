<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Earl Bacason | Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #071923;
            color: white;
            line-height: 1.6;
        }

        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: #071923;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            border-bottom: 1px solid #12313d;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #28d9d9;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

        nav a:hover {
            color: #28d9d9;
        }

        section {
            padding: 100px 8%;
        }

        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .hero h1 {
            font-size: clamp(40px, 8vw, 80px);
            margin-bottom: 20px;
        }

        .highlight {
            color: #28d9d9;
        }

        .cursor {
            color: #28d9d9;
            animation: blink 0.7s infinite;
        }

        @keyframes blink {
            50% {
                opacity: 0;
            }
        }

        .hero p {
            max-width: 700px;
            color: #b8c7cc;
            font-size: 17px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 12px 25px;
            background: #28d9d9;
            color: #071923;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        .btn:hover {
            background: white;
        }

        .title {
            text-align: center;
            font-size: 35px;
            margin-bottom: 40px;
        }

        .about {
            max-width: 900px;
            margin: auto;
            text-align: center;
            color: #c4d0d4;
        }

        .skills,
        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .card {
            background: #0c2733;
            padding: 25px;
            border-radius: 10px;
            border: 1px solid #17404e;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: #28d9d9;
        }

        .card h3 {
            color: #28d9d9;
            margin-bottom: 10px;
        }

        .card p {
            color: #b8c7cc;
        }

        .education {
            text-align: center;
        }

        .education h3 {
            color: #28d9d9;
            font-size: 24px;
        }

        .contact {
            text-align: center;
        }

        .contact p {
            color: #b8c7cc;
            margin: 10px;
        }

        footer {
            text-align: center;
            padding: 25px;
            background: #05131a;
            color: #81969d;
        }

        @media (max-width: 600px) {
            header {
                padding: 15px 5%;
            }

            nav a {
                margin-left: 8px;
                font-size: 11px;
            }

            section {
                padding: 90px 6%;
            }

            .hero h1 {
                font-size: 42px;
            }
        }
    </style>
</head>

